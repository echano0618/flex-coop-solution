{
  "name": "@flexcoop/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node dist/test/suite.js",
    "test:emulator": "firebase emulators:exec --only firestore,auth \"tsc && node dist/test/suite.js\"",
    "start": "node dist/index.js",
    "start:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 node dist/index.js",
    "dev": "tsc -w & node --watch dist/index.js",
    "dev:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npm run dev"
  },
  "dependencies": {
    "@flexcoop/cda-coa": "^1.0.0",
    "@flexcoop/db-migrations": "^1.0.0",
    "@flexcoop/shared-types": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^14.5.0",
    "nodemailer": "^10.1.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.2",
    "typescript": "^5.4.5"
  }
}
