{
  "name": "flex-coop-solution",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise SaaS Cooperative Banking and Lending Platform (CDA-compliant)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "test:emulator": "firebase emulators:exec --only firestore,auth \"npm run test\"",
    "test:local": "npm run test:emulator",
    "emulator:start": "firebase emulators:start --only firestore,auth,storage",
    "dev:local": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npm run dev:api",
    "dev:api": "npm --workspace=apps/api run dev",
    "dev:admin": "npm --workspace=apps/admin-portal run dev",
    "lint": "npm run --workspaces --if-present lint",
    "predeploy:check": "bash scripts/predeploy-check.sh",
    "deploy:cloudrun": "bash scripts/deploy-cloudrun.sh"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.4.5"
  }
}
